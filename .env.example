# --- Session / Security ---
# Required in production. Generate one with: openssl rand -base64 32
SESSION_SECRET=

# --- Admin authentication ---
# Password sign-in (optional fallback). Leave unset to disable password login.
ADMIN_PASSWORD=

# Google OAuth (recommended for production).
# Create credentials at https://console.cloud.google.com/apis/credentials
# - Application type: Web application
# - Authorized redirect URI: https://YOUR-DOMAIN/auth/google/callback
#   (add http://localhost:3000/auth/google/callback for local development)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated list of Google accounts allowed into /admin.
# WARNING: if left empty, any Google account can sign in.
ADMIN_EMAILS=

# --- Storage ---
# Directory for the SQLite database file. Point this at a persistent
# volume when deploying (most PaaS filesystems are ephemeral otherwise).
DATA_DIR=./.data

# --- Server ---
PORT=3000
